<div class="flex flex-col">
  <p class="text-sm mb-4">
    {gettext(
      "Emails are sent through the Cloudflare Email Service API. The API token needs the “Email Sending: Edit” permission, and the sender address must be on a domain that is onboarded for Email Sending in Cloudflare."
    )}
  </p>

  <div class="form-row">
    {label(@form, :cloudflare_account_id, gettext("Account ID"))}
    <%= with_validation(@form, :cloudflare_account_id) do %>
      {text_input(@form, :cloudflare_account_id, class: "text-black")}
    <% end %>
  </div>

  <%= if is_nil(@form.data.cloudflare_api_token) do %>
    <div class="form-row">
      {label(@form, :cloudflare_api_token, gettext("API Token"))}
      <%= with_validation(@form, :cloudflare_api_token) do %>
        {password_input(@form, :cloudflare_api_token, class: "text-black", phx_update: :ignore)}
      <% end %>
    </div>
  <% else %>
    <div
      x-data="{ show: false }"
      x-init="$watch('show', show => { $nextTick(() => { if (show) $refs.password.focus() }) })"
      class="form-row"
    >
      <div class="flex gap-5">
        {label(@form, :cloudflare_api_token, gettext("API Token"))}
        <label>
          <input type="checkbox" x-model="show" />
          {gettext("Change")}
        </label>
      </div>

      <template x-if="show">
        <%= with_validation(@form, :cloudflare_api_token) do %>
          {password_input(@form, :cloudflare_api_token, class: "text-black", x_ref: "password")}
        <% end %>
      </template>
    </div>
  <% end %>
</div>
