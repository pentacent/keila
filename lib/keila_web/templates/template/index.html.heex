<div class="container flex py-8 sm:py-11 mb-4">
  <div class="flex-grow gap-4 flex flex-col sm:flex-row sm:items-center">
    <h1 class="text-2xl sm:text-3xl text-gray-100">
      {gettext("Templates")}
    </h1>
    <div class="flex-grow flex flex-row-reverse justify-end gap-4 sm:flex-row">
      <a href={~p"/projects/#{@current_project.id}/templates/new"} class="button">
        {render_icon(:document_add)}
        {gettext("Create a new template")}
      </a>
    </div>
  </div>
</div>

<%= if Enum.empty?(@templates) do %>
  {render("_empty_state.html", assigns)}
<% end %>

<div class="container grid gap-x-8 gap-y-12 sm:grid-cols-2 xl:grid-cols-3">
  <%= for template <- @templates do %>
    <div class="flex flex-col">
      <KeilaWeb.PreviewIframe.thumbnail_iframe
        href={~p"/projects/#{@current_project.id}/templates/#{template.id}"}
        src={~p"/projects/#{@current_project.id}/templates/#{template.id}/preview"}
        title={template.name}
      />
      <h2 class="text-xl text-gray-100 mb-1 truncate" title={template.name}>
        <a
          href={~p"/projects/#{@current_project.id}/templates/#{template.id}"}
          class="hover:underline"
        >
          {template.name}
        </a>
      </h2>
      <p class="text-sm text-gray-400 flex flex-wrap items-center gap-x-2 whitespace-nowrap">
        {[gettext("Updated at:"), " ", local_datetime_tag(template.updated_at)]}
      </p>
      <div class="flex flex-row gap-4 mt-4">
        <a href={~p"/projects/#{@current_project.id}/templates/#{template.id}"} class="button">
          {render_icon(:pencil_alt)}
          {gettext("Edit")}
        </a>
        <a
          href={~p"/projects/#{@current_project.id}/templates/#{template.id}/clone"}
          class="button button--text"
        >
          {render_icon(:duplicate)}
          {gettext("Clone")}
        </a>
      </div>
    </div>
  <% end %>
</div>
