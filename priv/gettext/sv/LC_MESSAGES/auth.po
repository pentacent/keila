#: lib/keila_web/controllers/auth_controller.ex:90
msgid "Activation required"
msgstr "Aktivering krävs"

#: lib/keila_web/controllers/auth_controller.ex:78
msgid "Activation successful"
msgstr "Aktiveringen lyckades"

#: lib/keila_web/templates/auth/activate_resend_success.html.heex:4
#: lib/keila_web/templates/auth/register_success.html.heex:4
#: lib/keila_web/templates/auth/reset_success.html.heex:4
msgid "Check your inbox!"
msgstr "Kontrollera din inkorg!"

#: lib/keila_web/templates/auth/login.html.heex:34
msgid "Don’t have an account?"
msgstr "Har du inget konto?"

#: lib/keila_web/templates/auth/login.html.heex:40
msgid "Forgot your password?"
msgstr "Glömt lösenordet?"

#: lib/keila_web/templates/auth/activate_success.html.heex:12
msgid "Get started!"
msgstr "Kom igång!"

#: lib/keila/auth/emails.ex:46
msgid ""
"Hey there,\n"
"\n"
"please confirm your new email address by visiting the following link:\n"
"\n"
"%{url}\n"
"\n"
"If you weren’t trying to change your email address, simply ignore this message.\n"
msgstr ""
"Hej!\n"
"\n"
"Bekräfta din nya e-postadress genom att besöka följande länk:\n"
"\n"
"%{url}\n"
"\n"
"Om du inte försökte ändra din e-postadress kan du ignorera det här meddelandet.\n"

#: lib/keila/auth/emails.ex:95
msgid ""
"Hey there,\n"
"\n"
"you can login to Keila with the following link:\n"
"\n"
"%{url}\n"
"\n"
"If you haven’t requested a login, simply ignore this message.\n"
msgstr ""
"Hej!\n"
"\n"
"Du kan logga in i Keila via följande länk:\n"
"\n"
"%{url}\n"
"\n"
"Om du inte har begärt en inloggning kan du ignorera det här meddelandet.\n"

#: lib/keila/auth/emails.ex:70
msgid ""
"Hey there,\n"
"\n"
"you have requested a password reset for your Keila account.\n"
"\n"
"You can set a new password by visiting the following link:\n"
"\n"
"%{url}\n"
"\n"
"If you weren’t trying to reset your password, simply ignore this message.\n"
msgstr ""
"Hej!\n"
"\n"
"Du har begärt att lösenordet för ditt Keila-konto ska återställas.\n"
"\n"
"Du kan ange ett nytt lösenord genom att besöka följande länk:\n"
"\n"
"%{url}\n"
"\n"
"Om du inte försökte återställa ditt lösenord kan du ignorera det här meddelandet.\n"

#: lib/keila_web/templates/auth/reset_success.html.heex:7
msgid "If you have an account, we’ve sent you a verification link to %{email}."
msgstr "Om du har ett konto har vi skickat en verifieringslänk till %{email}."

#: lib/keila_web/templates/auth/404.html.heex:7
msgid "It seems like your link has expired or is invalid."
msgstr "Det verkar som om länken har gått ut eller är ogiltig."

#: lib/keila_web/controllers/account_controller.ex:42
msgid "Manage Account"
msgstr "Hantera konto"

#: lib/keila_web/controllers/account_controller.ex:18
msgid "New password saved."
msgstr "Det nya lösenordet har sparats."

#: lib/keila_web/controllers/auth_controller.ex:217
msgid "Not found"
msgstr "Hittades inte"

#: lib/keila_web/controllers/auth_controller.ex:128
#: lib/keila_web/controllers/auth_controller.ex:141
#: lib/keila_web/controllers/auth_controller.ex:174
msgid "Password reset"
msgstr "Återställ lösenord"

#: lib/keila_web/controllers/auth_controller.ex:161
msgid "Password reset successful"
msgstr "Lösenordet har återställts"

#: lib/keila/auth/emails.ex:19
msgid "Please Verify Your Account"
msgstr "Bekräfta ditt konto"

#: lib/keila/auth/emails.ex:43
msgid "Please Verify Your Email"
msgstr "Bekräfta din e-postadress"

#: lib/keila_web/templates/auth/activate_required.html.heex:4
msgid "Please activate your account first."
msgstr "Aktivera ditt konto först."

#: lib/keila_web/controllers/auth_controller.ex:45
#: lib/keila_web/controllers/public_form_controller.ex:64
msgid "Please complete the captcha."
msgstr "Slutför captcha-kontrollen."

#: lib/keila_web/templates/auth/activate_required.html.heex:15
msgid "Resend activation link"
msgstr "Skicka aktiveringslänken igen"

#: lib/keila_web/templates/auth/login.html.heex:42
msgid "Reset your password."
msgstr "Återställ ditt lösenord."

#: lib/keila_web/controllers/auth_controller.ex:197
#: lib/keila_web/templates/auth/login.html.heex:30
msgid "Sign in"
msgstr "Logga in"

#: lib/keila_web/templates/auth/login.html.heex:13
msgid "Sign in with your email address and password here."
msgstr "Logga in här med din e-postadress och ditt lösenord."

#: lib/keila_web/templates/auth/login.html.heex:10
msgid "Sign in."
msgstr "Logga in."

#: lib/keila_web/controllers/auth_controller.ex:59
msgid "Sign up"
msgstr "Registrera dig"

#: lib/keila_web/controllers/auth_controller.ex:34
msgid "Sign up successful"
msgstr "Registreringen lyckades"

#: lib/keila_web/templates/auth/login.html.heex:36
msgid "Sign up."
msgstr "Registrera dig."

#: lib/keila_web/templates/auth/activate_success.html.heex:7
msgid "Thanks for verifying your email."
msgstr "Tack för att du bekräftade din e-postadress."

#: lib/keila_web/templates/auth/404.html.heex:4
msgid "That didn’t work :-("
msgstr "Det fungerade inte :-("

#: lib/keila_web/templates/auth/activate_success.html.heex:4
msgid "Welcome to Keila!"
msgstr "Välkommen till Keila!"

#: lib/keila/auth/emails.ex:22
msgid ""
"Welcome to Keila,\n"
"\n"
"please confirm your new account by visiting the following link:\n"
"\n"
"%{url}\n"
"\n"
"If you weren’t trying to create an account, simply ignore this message.\n"
msgstr ""
"Välkommen till Keila!\n"
"\n"
"Bekräfta ditt nya konto genom att besöka följande länk:\n"
"\n"
"%{url}\n"
"\n"
"Om du inte försökte skapa ett konto kan du ignorera det här meddelandet.\n"

#: lib/keila_web/templates/auth/activate_resend_success.html.heex:7
msgid "We’ve resent your verification link to %{email}."
msgstr "Vi har skickat verifieringslänken på nytt till %{email}."

#: lib/keila_web/templates/auth/register_success.html.heex:7
msgid "We’ve sent you a verification link to %{email}."
msgstr "Vi har skickat en verifieringslänk till %{email}."

#: lib/keila_web/templates/auth/reset_change_password_success.html.heex:7
msgid "You can now continue using Keila."
msgstr "Du kan nu fortsätta använda Keila."

#: lib/keila_web/templates/auth/activate_required.html.heex:7
msgid "You need to verify your email before you can use Keila. Please check your inbox."
msgstr "Du måste bekräfta din e-postadress innan du kan använda Keila. Kontrollera din inkorg."

#: lib/keila/auth/emails.ex:66
msgid "Your Account Reset Link"
msgstr "Länk för att återställa ditt konto"

#: lib/keila/auth/emails.ex:91
msgid "Your Login Link"
msgstr "Din inloggningslänk"

#: lib/keila_web/templates/auth/reset_change_password_success.html.heex:12
msgid "Log in with your new password"
msgstr "Logga in med ditt nya lösenord"

#: lib/keila/auth/emails.ex:119
msgid ""
"Hey there,\n"
"\n"
"please verify your sender email address by visiting the following link:\n"
"\n"
"%{url}\n"
"\n"
"If you didn't request this verification, please ignore this message and\n"
"do not click on the link.\n"
msgstr ""
"Hej!\n"
"\n"
"Bekräfta avsändaradressen genom att besöka följande länk:\n"
"\n"
"%{url}\n"
"\n"
"Om du inte begärde denna verifiering kan du ignorera det här meddelandet.\n"
"Klicka inte på länken.\n"

#: lib/keila/auth/emails.ex:115
msgid "Please Verify Your Email for Keila"
msgstr "Bekräfta din e-postadress för Keila"
