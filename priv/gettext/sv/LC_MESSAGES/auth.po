msgstr "Kom igång!"

#: lib/keila/auth/emails.ex:46
#, elixir-autogen, elixir-format
msgid "Hey there,\n\nplease confirm your new email address by visiting the following link:\n\n%{url}\n\nIf you weren’t trying to change your email address, simply ignore this message.\n"
msgstr "Hej!\n\nBekräfta din nya e-postadress genom att besöka följande länk:\n\n%{url}\n\nOm du inte försökte ändra din e-postadress kan du ignorera det här meddelandet.\n"

#: lib/keila/auth/emails.ex:95
#, elixir-autogen, elixir-format
msgid "Hey there,\n\nyou can login to Keila with the following link:\n\n%{url}\n\nIf you haven’t requested a login, simply ignore this message.\n"
msgstr "Hej!\n\nDu kan logga in i Keila via följande länk:\n\n%{url}\n\nOm du inte har begärt en inloggning kan du ignorera det här meddelandet.\n"

#: lib/keila/auth/emails.ex:70
#, elixir-autogen, elixir-format
msgid "Hey there,\n\nyou have requested a password reset for your Keila account.\n\nYou can set a new password by visiting the following link:\n\n%{url}\n\nIf you weren’t trying to reset your password, simply ignore this message.\n"
msgstr "Hej!\n\nDu har begärt att lösenordet för ditt Keila-konto ska återställas.\n\nDu kan ange ett nytt lösenord genom att besöka följande länk:\n\n%{url}\n\nOm du inte försökte återställa ditt lösenord kan du ignorera det här meddelandet.\n"

#: lib/keila_web/templates/auth/reset_success.html.heex:7
#, elixir-autogen, elixir-format
msgid "If you have an account, we’ve sent you a verification link to %{email}."
msgstr "Om du har ett konto har vi skickat en verifieringslänk till %{email}."

#: lib/keila_web/templates/auth/404.html.heex:7
#, elixir-autogen, elixir-format
msgid "It seems like your link has expired or is invalid."
msgstr "Det verkar som om länken har gått ut eller är ogiltig."

